{
  "id": "fold-test",
  "name": "Fold test",
  "description": "The test site of browser_fold.js: a search field and an icon-only button above the links, a section whose title sits in a button, rows with a menu button and a checkbox.",
  "matches": [
    "https://example.com/browser/browser/components/fold/tests/browser/*"
  ],
  "root": ["#sidebar nav"],
  "hide": ["#sidebar"],
  "remove": ["#open-nav"],
  "css": [
    "body { grid-template-columns: minmax(0, 1fr) !important; }",
    "main { grid-column: 1 / -1 !important; }"
  ],
  "ready": { "minItems": 3, "timeoutMs": 3000 },
  "current": "marker",
  "main": [
    {
      "paths": [
        "/browser/browser/components/fold/tests/browser/file_fold_site.html?view=home"
      ],
      "icon": "home"
    },
    {
      "paths": [
        "/browser/browser/components/fold/tests/browser/file_fold_site.html?view=explore"
      ],
      "icon": "explore"
    }
  ],
  "groups": {
    "each": ".section",
    "heading": ".title",
    "items": "a[href], button, input",
    "container": ".row"
  },
  "extras": [{ "items": ".search input, .new", "at": "start" }]
}
